{
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/package-lock.json",
      "!**/.taste-skill",
      "!**/assets/taste",
      "!**/public/taste"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "suspicious": {
        "noDebugger": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateCase": "error"
      },
      "correctness": {
        "noUnreachable": "error"
      }
    }
  }
}
