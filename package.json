{
  "name": "calculadora-trabalhista",
  "version": "1.0.0",
  "private": true,
  "description": "Simulador de salário líquido, 13º e férias em HTML, CSS e JavaScript puro",
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch",
    "lint": "biome lint .",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base ./",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e:security": "playwright test",
    "test:coverage": "c8 --reporter=lcov --reporter=text node --test test/*.test.js"
  },
  "keywords": [
    "javascript",
    "html",
    "css",
    "folha-de-pagamento",
    "inss",
    "irrf"
  ],
  "author": "Leonardo Fernandes Carrilho",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "c8": "^12.0.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@sentry/browser": "^11.10.0"
  }
}
